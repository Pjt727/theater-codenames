# Copy this file to .env and fill in your values

# Public URL used to generate join links and QR codes.
# Default is http://localhost:5001 if not set.
# Examples:
#   Local network:  SITE_URL=http://192.168.1.42:5001
#   Tunnel (ngrok): SITE_URL=https://abc123.ngrok-free.app
#   Production:     SITE_URL=https://codenames.yourdomain.com
SITE_URL=http://localhost:5001
